name: iptables-firewall-lab

topology:
  nodes:
    # Alpine Linux Firewall Router
    router:
      kind: linux
      image: alpine:latest
      binds:
        - config/iptables.rules:/etc/iptables/rules.v4
      exec:
        - apk add --no-cache iptables
        - ip addr add 10.1.1.1/24 dev eth1
        - ip addr add 192.168.10.1/24 dev eth2
        - ip addr add 172.16.1.1/24 dev eth3
        - ip addr add 172.16.1.2/24 dev eth4
        - sysctl -w net.ipv4.ip_forward=1
        - iptables-restore < /etc/iptables/rules.v4

    # LAN Client
    lan-client:
      kind: linux
      image: alpine:latest
      exec:
        - apk add --no-cache curl
        - ip addr add 10.1.1.10/24 dev eth1
        - ip route replace default via 10.1.1.1 dev eth1

    # DMZ Web Server
    dmz-server:
      kind: linux
      image: nginx:alpine
      exec:
        - ip addr add 192.168.10.10/24 dev eth1
        - ip route replace default via 192.168.10.1 dev eth1

    # WAN External Client
    wan-client:
      kind: linux
      image: alpine:latest
      exec:
        - apk add --no-cache curl
        - ip addr add 172.16.1.100/24 dev eth1
        - ip route replace default via 172.16.1.1 dev eth1

    # WAN Attacker / Blacklisted Host
    wan-attacker:
      kind: linux
      image: alpine:latest
      exec:
        - apk add --no-cache curl
        - ip addr add 172.16.1.200/24 dev eth1
        - ip route replace default via 172.16.1.2 dev eth1

  links:
    - endpoints: ["dmz-server:eth1", "router:eth2"]
    - endpoints: ["lan-client:eth1", "router:eth1"]
    - endpoints: ["wan-client:eth1", "router:eth3"]
    - endpoints: ["wan-attacker:eth1", "router:eth4"]
